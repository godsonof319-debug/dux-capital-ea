# ============================================================
#  JARVIS configuration — copy this file to ".env" and edit
# ============================================================

# ---- AI brain (optional, but recommended for smart answers) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model to use (gpt-4o-mini is cheap & fast; gpt-4o is smarter)
OPENAI_MODEL=gpt-4o-mini

# ---- Assistant persona ----
ASSISTANT_NAME=Jarvis
# Name Jarvis will call you
USER_NAME=Sir
# The wake word (used in --wake mode). Say this to activate.
WAKE_WORD=jarvis

# ---- Voice settings ----
# 1 = speak responses out loud, 0 = text only
VOICE_ENABLED=1
# Words per minute for text-to-speech (150-200 is natural)
TTS_RATE=185
# 0.0 to 1.0
TTS_VOLUME=1.0
# Substring to pick a specific installed voice (e.g. "zira", "david"). Blank = default.
TTS_VOICE=

# ---- Offline wake word (optional, for --wake / hands-free GUI) ----
# Download a model from https://alphacephei.com/vosk/models
# (e.g. vosk-model-small-en-us-0.15), unzip it, and point here — OR just drop
# the unzipped folder into jarvis/models/ and it's auto-detected.
VOSK_MODEL_PATH=

# ---- Weather (optional) ----
# Free key from https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Default city used when you just say "weather"
DEFAULT_CITY=Windhoek
# metric = Celsius, imperial = Fahrenheit
WEATHER_UNITS=metric
