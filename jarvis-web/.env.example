# ============================================================
#  JARVIS Web configuration — copy to ".env" and fill in
# ============================================================

# Port the server listens on
PORT=3000

# ---- AI brain (optional but recommended) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Persona ----
ASSISTANT_NAME=Jarvis
USER_NAME=Sir

# ---- Weather (optional) ----
# Free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
DEFAULT_CITY=Windhoek
WEATHER_UNITS=metric

# ---- LMS (Moodle) ----
# Base URL of the Moodle site students log into. Works for any Moodle install.
# Live data requires the site to have Web Services + the mobile service enabled
# (default on most Moodle sites). Students log in with THEIR OWN credentials;
# no tokens or passwords are ever hardcoded.
LMS_URL=https://elearn.ium.edu.na

# ---- Admin (your app's own resource library) ----
# Set a passphrase to enable the Admin tab (upload/manage modules, resources,
# announcements, and view download stats). If left blank, admin is DISABLED.
ADMIN_PASSWORD=
