# ============================================================
#  JARVIS Web configuration — copy to ".env" and fill in
# ============================================================

# Port the server listens on
PORT=3000

# ---- AI brain (optional but recommended) ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Persona ----
ASSISTANT_NAME=Jarvis
USER_NAME=Sir

# ---- Weather (optional) ----
# Free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
DEFAULT_CITY=Windhoek
WEATHER_UNITS=metric
